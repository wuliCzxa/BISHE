<!--pages/register/register.wxml-->
<view class="container">
  <view class="header">
    <text class="title">注册新账号</text>
  </view>

  <view class="form-section">
    <view class="input-group">
      <view class="input-label">
        <image class="icon" src="/images/user.png"></image>
      </view>
      <input 
        class="input-field" 
        type="text" 
        placeholder="请输入用户名（3-20位字母数字）" 
        value="{{username}}"
        bindinput="onUsernameInput"
      />
    </view>

    <view class="input-group">
      <view class="input-label">
        <image class="icon" src="/images/lock.png"></image>
      </view>
      <input 
        class="input-field" 
        type="{{showPassword ? 'text' : 'password'}}" 
        placeholder="请输入密码（至少6位）" 
        value="{{password}}"
        bindinput="onPasswordInput"
      />
      <view class="toggle-password" bindtap="togglePassword">
        <image class="icon-small" src="{{showPassword ? '/images/eye-open.png' : '/images/eye-close.png'}}"></image>
      </view>
    </view>

    <view class="input-group">
      <view class="input-label">
        <image class="icon" src="/images/lock.png"></image>
      </view>
      <input 
        class="input-field" 
        type="{{showConfirmPassword ? 'text' : 'password'}}" 
        placeholder="请再次输入密码" 
        value="{{confirmPassword}}"
        bindinput="onConfirmPasswordInput"
      />
      <view class="toggle-password" bindtap="toggleConfirmPassword">
        <image class="icon-small" src="{{showConfirmPassword ? '/images/eye-open.png' : '/images/eye-close.png'}}"></image>
      </view>
    </view>

    <button class="register-btn" bindtap="handleRegister" disabled="{{loading}}">
      {{loading ? '注册中...' : '注册'}}
    </button>

    <view class="actions">
      <navigator url="/pages/login/login" open-type="navigateBack" class="link">
        <text>已有账号？立即登录</text>
      </navigator>
    </view>
  </view>
</view>
