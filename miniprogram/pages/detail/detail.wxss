/* pages/detail/detail.wxss */
.container {
  height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 30rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.scroll-content {
  flex: 1;
  padding: 20rpx;
}

.section {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2px solid #667eea;
}

.info-card {
  background-color: #f9f9f9;
  border-radius: 10rpx;
  padding: 20rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  font-size: 28rpx;
  border-bottom: 1px solid #eee;
}

.info-item:last-child {
  border-bottom: none;
}

.label {
  color: #666;
  width: 180rpx;
}

.value {
  flex: 1;
  color: #333;
  font-weight: bold;
  text-align: right;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.status-success {
  color: #52c41a;
}

.status-failed {
  color: #f5222d;
}

.status-running {
  color: #1890ff;
}

.status-pending {
  color: #faad14;
}

.reading-card {
  display: flex;
  justify-content: space-around;
  background-color: #f9f9f9;
  border-radius: 10rpx;
  padding: 30rpx;
}

.reading-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.reading-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 15rpx;
}

.reading-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.reading-value.highlight {
  color: #667eea;
}

.detail-image {
  width: 100%;
  height: 400rpx;
  border-radius: 10rpx;
  background-color: #f5f5f5;
}

.result-images {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.image-wrapper {
  display: flex;
  flex-direction: column;
}

.image-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.result-image {
  width: 100%;
  height: 300rpx;
  border-radius: 10rpx;
  background-color: #f5f5f5;
}

.action-section {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  padding: 20rpx;
}

.action-btn {
  flex: 1;
  min-width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 10rpx;
  border: none;
  color: #fff;
}

.modify-btn {
  background-color: #faad14;
}

.confirm-btn {
  background-color: #52c41a;
}

.chart-btn {
  background-color: #1890ff;
}

.loading-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}
